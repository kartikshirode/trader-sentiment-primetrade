# Copy this file to .env and paste your Binance Futures Testnet API credentials.
# Generate keys at https://testnet.binancefuture.com after signing in with GitHub or Google.
# DO NOT commit the real .env file (already gitignored at repo root).

BINANCE_TESTNET_API_KEY=your_64_char_api_key_here
BINANCE_TESTNET_API_SECRET=your_64_char_api_secret_here

# Optional: force dry-run mode even when keys are present.
# DRY_RUN=1
